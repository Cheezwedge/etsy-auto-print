# Install (adjust paths/user to your machine):
#   sudo cp systemd/etsy-auto-print.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now etsy-auto-print
[Unit]
Description=Etsy auto-print order poller
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/etsy-auto-print
ExecStart=/home/pi/etsy-auto-print/.venv/bin/etsy-auto-print run
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
