#!/usr/bin/env bash
# One-click: connect to the print Pi, make sure the dashboard is running,
# forward its port, and open it in this machine's browser.
#
# Run by the "Etsy Label Dashboard" desktop launcher, but it works standalone:
#     ./etsy-dashboard youruser@printpi.local
#
# The dashboard binds to localhost on the Pi and is reached through the SSH
# tunnel, so it is never exposed to your network and needs no dashboard
# password. You type your SSH password once, in the terminal window.

set -u

TARGET="${1:-${ETSY_PI_HOST:-}}"
REMOTE_DIR="${ETSY_PI_DIR:-etsy-auto-print}"
PORT="${ETSY_DASHBOARD_PORT:-8765}"
URL="http://127.0.0.1:${PORT}/"
# Generous: this clock also covers however long you take to type the password.
WAIT_SECONDS="${ETSY_DASHBOARD_WAIT:-120}"

# Everything that happens is also appended here, so a window that closes too
# fast to read never loses the reason why.
LOG="${XDG_CACHE_HOME:-$HOME/.cache}/etsy-auto-print/launcher.log"
mkdir -p "$(dirname "$LOG")" 2>/dev/null || LOG=/dev/null
printf '\n=== %s === target=%s port=%s\n' \
  "$(date '+%Y-%m-%d %H:%M:%S')" "${TARGET:-<none>}" "$PORT" >>"$LOG" 2>/dev/null

say() {
  echo "$*"
  echo "$*" >>"$LOG" 2>/dev/null
}

# Keep the window up on failure — a launcher-spawned terminal usually closes
# the instant the script exits, taking the error message with it. Armed before
# the first thing that can fail, so no message is ever lost.
#
# Read from /dev/tty rather than stdin: a desktop launcher commonly hands the
# process /dev/null on stdin, which makes a plain `read` return instantly and
# close the window anyway — the exact thing this is here to prevent.
hold_window() {
  echo
  echo "Full log: $LOG"
  # /dev/tty can exist but not be openable (cron, some launchers), so the
  # redirect itself has to be allowed to fail quietly.
  # Redirections apply left to right, so stderr must be silenced *before* the
  # /dev/tty open is attempted or its failure still reaches the screen.
  if read -r -p "Press Enter to close this window. " _ 2>/dev/null </dev/tty; then
    return
  fi
  # No terminal to prompt on. Stay alive briefly so the text stays readable.
  echo "(closing in 90s — Ctrl-C to close now)"
  sleep 90
}
trap hold_window EXIT

if [ -z "$TARGET" ]; then
  say "No Pi to connect to."
  echo
  say "Pass it as an argument:   $0 youruser@printpi.local"
  say "or set the environment:   ETSY_PI_HOST=youruser@printpi.local"
  exit 2
fi

if ! command -v ssh >/dev/null 2>&1; then
  say "ssh is not installed on this machine."
  say "Install it with:   sudo apt install openssh-client"
  exit 127
fi

# --- is the dashboard actually answering on the forwarded port? ------------
# A plain TCP check is not enough: `ssh -L` accepts the local connection
# before it knows whether anything is listening on the far end, so the port
# looks open while the page would still fail to load. Ask for the page.
http_ready() {
  if command -v curl >/dev/null 2>&1; then
    curl -s -o /dev/null --max-time 3 "$URL"
    return
  fi
  (
    exec 3<>"/dev/tcp/127.0.0.1/${PORT}" 2>/dev/null || exit 1
    printf 'GET / HTTP/1.0\r\n\r\n' >&3
    head -c 12 <&3 | grep -q HTTP
  ) 2>/dev/null
}

open_browser() {
  for opener in xdg-open sensible-browser x-www-browser firefox chromium google-chrome; do
    if command -v "$opener" >/dev/null 2>&1; then
      say "Opening $URL with $opener"
      "$opener" "$URL" >>"$LOG" 2>&1 &
      return 0
    fi
  done
  say "No browser launcher found — open this yourself: $URL"
}

# Already connected from an earlier launch? Just bring up the page again.
if http_ready; then
  say "Dashboard is already reachable at $URL — opening it."
  open_browser
  # Give a just-spawned browser a moment before the window disappears.
  sleep 2
  trap - EXIT
  exit 0
fi

# --- remote side ----------------------------------------------------------
# Reuse a dashboard that is already running on the Pi (e.g. its own systemd
# unit) instead of starting a second one that would fail to bind the port.
# Single quotes are deliberately absent so the whole thing can be quoted once.
REMOTE_CMD="
cd ${REMOTE_DIR} || { echo \"Cannot find ${REMOTE_DIR} on the Pi\"; exit 1; }
if (exec 3<>/dev/tcp/127.0.0.1/${PORT}) 2>/dev/null; then
  echo == Dashboard already running on the Pi. Tunnel is open.
  echo == Leave this window open while you use it; press Ctrl-C to disconnect.
  while :; do sleep 3600; done
else
  echo == Starting the dashboard on the Pi...
  exec .venv/bin/etsy-auto-print dashboard --port ${PORT}
fi
"

say "Connecting to ${TARGET} ..."
say "(enter your Pi password if prompted; the browser opens by itself)"
echo

# Open the browser as soon as the page actually answers, without blocking ssh.
# The clock is wall-time, not loop iterations, because each probe can itself
# take a few seconds. If ssh exits first this subshell is killed, so the
# give-up message only ever appears while the connection is genuinely up.
(
  deadline=$(( $(date +%s) + WAIT_SECONDS ))
  while [ "$(date +%s)" -lt "$deadline" ]; do
    if http_ready; then
      open_browser
      exit 0
    fi
    sleep 1
  done
  echo
  say "Still nothing on $URL after ${WAIT_SECONDS}s."
  say "The connection is up, so the dashboard itself did not start — the"
  say "messages above should say why. Common cause: the dashboard extra is"
  say "not installed on the Pi (.venv/bin/pip install -e \".[dashboard]\")."
) &
WAITER=$!

# ExitOnForwardFailure: fail loudly if port $PORT is already taken locally,
# rather than connecting with no working tunnel.
# ssh's own errors are teed into the log; stdin and stdout stay attached to the
# terminal so the password prompt and remote output behave normally.
ssh -t \
  -o ExitOnForwardFailure=yes \
  -o ServerAliveInterval=30 \
  -L "${PORT}:127.0.0.1:${PORT}" \
  "$TARGET" "$REMOTE_CMD" 2> >(tee -a "$LOG" >&2)
STATUS=$?

kill "$WAITER" 2>/dev/null || true
wait "$WAITER" 2>/dev/null || true

echo
if [ "$STATUS" -eq 0 ]; then
  say "Disconnected from ${TARGET}."
else
  say "Connection to ${TARGET} ended with status ${STATUS}."
  case "$STATUS" in
    255) say "ssh could not connect. Check the hostname, and that you can run:"
         say "    ssh ${TARGET}" ;;
    *)   say "If port ${PORT} was already in use here, close the other dashboard"
         say "window first." ;;
  esac
fi
exit "$STATUS"
